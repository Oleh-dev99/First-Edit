{
  "name": "first-edit-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Render harness for First Edit: Vite app + Playwright runner.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "node scripts/check.ts",
    "dev": "vite",
    "smoke": "node scripts/smoke.ts",
    "stress": "node scripts/stress.ts",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright": "1.65.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
